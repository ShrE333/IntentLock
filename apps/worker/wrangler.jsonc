{
  "name": "intentlock-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PurchaseAgent",
        "class_name": "PurchaseAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PurchaseAgent"]
    }
  ]
,
  "queues": {
    "producers": [
      {
        "binding": "PURCHASE_QUEUE",
        "queue": "intentlock-purchase-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "intentlock-purchase-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "retry_delay": 3
      }
    ]
  }
}
