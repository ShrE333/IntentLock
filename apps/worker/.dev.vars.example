APPROVAL_SIGNING_SECRET=replace-with-at-least-24-random-characters
INTENTLOCK_AUTH_SIGNING_SECRET=replace-with-a-separate-random-signing-secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REST_TOKEN

# Payment rail selection is capability-based. The first configured rail that
# supports the merchant presentment currency/country is selected.
PAYMENT_PROVIDER=auto
PAYMENT_PROVIDER_ORDER=paypal,razorpay

# PayPal sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_SANDBOX_CLIENT_SECRET
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID
PAYPAL_RETURN_BASE_URL=http://localhost:3000
# Set these to the connected PayPal seller account, not the buyer.
# PAYPAL_ACCOUNT_COUNTRY=US
# PAYPAL_ACCEPTED_CURRENCIES=USD,EUR,GBP,SGD,AUD,CAD,JPY
# Optional IntentLock country policy allowlists (comma-separated ISO alpha-2).
# PAYPAL_ALLOWED_BUYER_COUNTRIES=IN,US,GB,DE,SG
# PAYPAL_ALLOWED_MERCHANT_COUNTRIES=IN,US,GB,DE,SG

# Razorpay / alternate rail
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=choose-a-separate-random-webhook-secret
RAZORPAY_ACCOUNT_COUNTRY=IN
RAZORPAY_ACCEPTED_CURRENCIES=INR
# RAZORPAY_ALLOWED_BUYER_COUNTRIES=IN
# RAZORPAY_ALLOWED_MERCHANT_COUNTRIES=IN

# eBay Browse connector (V11.1)
# Create keys at the eBay Developer Program. Sandbox and Production credentials
# are different. The connector uses client-credentials OAuth and never exposes
# the client secret to the browser.
EBAY_ENV=sandbox
EBAY_CLIENT_ID=YOUR_EBAY_SANDBOX_CLIENT_ID
EBAY_CLIENT_SECRET=YOUR_EBAY_SANDBOX_CLIENT_SECRET
EBAY_MARKETPLACE_ID=EBAY_US
# Optional buyer context recommended by eBay for shipping/delivery estimates.
# EBAY_ENDUSER_COUNTRY=US
# EBAY_ENDUSER_POSTAL_CODE=95008

# FX authorization layer.
# "static" is deterministic and stable for a hackathon demo; proof receipts label
# it DEMO_STATIC. Use FX_RATES_JSON to supply your own rates, or "frankfurter"
# for a live public quote source. Never present DEMO_STATIC as a live market rate.
FX_PROVIDER=static
FX_QUOTE_TTL_SECONDS=1800
FX_REVALIDATE=false
FX_MAX_DRIFT_BPS=100
# FX_RATES_JSON={"USD":1,"INR":83.5,"EUR":0.92,"GBP":0.78,"SGD":1.35}

# Used only when a commerce connector does not provide merchantCountry.
# COMMERCE_MERCHANT_COUNTRY=US

# V11.2 PayeeLock
# observe = bind + revalidate payee identity but do not require a registry match.
# enforce = fail closed unless the payee appears in PAYEELOCK_TRUSTED_PAYEES_JSON.
PAYEELOCK_MODE=observe
# PAYEELOCK_TRUSTED_PAYEES_JSON=[{"provider":"ebay","payeeId":"seller_username","merchantCountry":"US","label":"Approved eBay seller"}]

# Optional protected TrustOps mutation endpoint. Read-only Trust Center does not need this.
# Generate a long random value and store it as a Worker secret for production.
# TRUSTOPS_ADMIN_TOKEN=replace-with-long-random-secret

# V11.4 Post-Purchase Guard
# Refund requests are blocked when an unresolved PayPal dispute exists by default.
REFUND_MAX_AGE_DAYS=30
REFUND_BLOCK_ON_OPEN_DISPUTE=true
