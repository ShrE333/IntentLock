# INTENTLOCK V10.5 — WAHA ON EASYPANEL
# Replace every CHANGE_ME value.
# Never commit your real values.

WAHA_API_KEY=CHANGE_ME_LONG_RANDOM_API_KEY

WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

WAHA_DASHBOARD_ENABLED=True
WHATSAPP_SWAGGER_ENABLED=True

# Browserless engine: ideal for this single-session hackathon bridge.
WHATSAPP_DEFAULT_ENGINE=NOWEB
WAHA_NAMESPACE=all

WAHA_CLIENT_DEVICE_NAME=IntentLock

# EasyPanel replaces PRIMARY_DOMAIN with your generated HTTPS hostname.
WAHA_BASE_URL=https://$(PRIMARY_DOMAIN)
WAHA_PUBLIC_URL=https://$(PRIMARY_DOMAIN)

WAHA_LOG_FORMAT=JSON
WAHA_LOG_LEVEL=info
WAHA_PRINT_QR=False

WAHA_MEDIA_STORAGE=LOCAL
WHATSAPP_FILES_LIFETIME=0
WHATSAPP_FILES_FOLDER=/app/.media

# IntentLock Cloudflare Worker:
WHATSAPP_HOOK_URL=https://intentlock-worker.shdixit10.workers.dev/webhooks/waha
WHATSAPP_HOOK_EVENTS=message
WHATSAPP_HOOK_HMAC_KEY=CHANGE_ME_SAME_SECRET_AS_WORKER_WAHA_WEBHOOK_SECRET
WHATSAPP_HOOK_RETRIES_POLICY=exponential
WHATSAPP_HOOK_RETRIES_DELAY_SECONDS=2
WHATSAPP_HOOK_RETRIES_ATTEMPTS=5
